# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/kardexis
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT Configuration
# Must be at least 256 bits (32 characters) for HS256
JWT_SECRET=a-very-long-and-secure-secret-key-that-is-at-least-32-bytes-long

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# AWS S3 Configuration
S3_BUCKET=kardexis-attachments-dev
AWS_REGION=us-east-1
# AWS credentials are best injected via IAM roles in production.
# For local dev, you might use env vars:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key